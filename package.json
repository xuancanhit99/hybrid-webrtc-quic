{
  "name": "hybrid-webrtc-quic",
  "version": "0.1.0",
  "private": true,
  "description": "A dependency-free hybrid remote access control/signaling and file-transfer prototype.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test --test-concurrency=1",
    "test:unit": "node --test test/store.test.mjs test/protocol.test.mjs",
    "test:smoke": "node --test test/server.smoke.test.mjs"
  }
}
